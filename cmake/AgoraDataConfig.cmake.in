@PACKAGE_INIT@

# Consume AgoraData (libagora-data), Agora's Core Data.
#
# FOUNDATION IS FOUND FIRST AND NOT OPTIONALLY, because Core Data's headers cannot be preprocessed without it:
# `NSFetchRequest` names `NSPredicate` and `NSSortDescriptor`, `NSManagedObjectID` names `NSURL`, and
# `NSManagedObject` is an `NSObject`. That is also the direction the tier runs -- Foundation knows nothing of
# Core Data and must not, while Core Data is built on Foundation and cannot exist without it.

include(CMakeFindDependencyMacro)

find_dependency(Foundation CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/AgoraDataTargets.cmake")

check_required_components(AgoraData)
